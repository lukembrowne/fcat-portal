DEV_USER_EMAIL=lukebrowne@fcat-ecuador.org
DEV_USER_ROLE=super_admin
SUPER_ADMIN_EMAILS=lukebrowne@fcat-ecuador.org
ML_PYTHON_PATH=
DB_PATH=data/portal.db
ALLOWED_EMAILS_PATH=data/allowed_external_emails.txt

# ODK Central
ODK_CENTRAL_URL=https://central.fcat-ecuador.org
ODK_CENTRAL_EMAIL=
ODK_CENTRAL_PASSWORD=

# Google Sheets (BioChoco schedule)
GOOGLE_SERVICE_ACCOUNT_KEY=  # Base64-encoded service account JSON
BIOCHOCO_SHEET_ID=           # Google Sheets spreadsheet ID

# Camera Trap — Google Drive integration
CAMERA_TRAP_ROOT_FOLDER_ID=  # Drive folder ID for the root CameraTraps/ folder on Shared Drive

# Multi-Shared-Drive fan-out (both default OFF; flip discovery first, routing second)
SHARED_DRIVE_DISCOVERY_ENABLED=false  # Union discovery scan across registered drives
SHARED_DRIVE_ROUTING_ENABLED=false    # Route new deployment folders by capacity
# Optional threshold overrides (accept 75 or 0.75); defaults 0.75 / 0.85 / 0.95
# SHARED_DRIVE_SOFT_PCT=75
# SHARED_DRIVE_HARD_PCT=85
# SHARED_DRIVE_STOP_PCT=95
# Recipients for the daily Shared Drive capacity alert email (csv). Falls back
# to PORTAL_UPDATES_EMAILS if unset. Sent by /api/cron/shared-drive-alerts.
SHARED_DRIVE_ALERT_EMAILS=

# DB backup offload to a DigitalOcean Space (S3-compatible object storage).
# When enabled, the hourly backup is gzipped, uploaded to the Space, and only the
# last 6 hourly + newest daily are kept locally (~1.5 G vs ~38 G). Upload is
# verified BEFORE any local prune — a failed upload keeps the file on disk.
# Leave OFF until the Space + access key exist and s3cmd authenticates in-container.
# See docs/operations/disk-space-runbook.md for provisioning steps.
BACKUP_OFFLOAD_ENABLED=false
SPACES_ENDPOINT=              # e.g. nyc3.digitaloceanspaces.com (region host, no bucket, no scheme)
SPACES_REGION=               # e.g. nyc3
SPACES_BUCKET=               # e.g. fcat-portal-backups (private ACL)
SPACES_KEY=                  # Spaces access key
SPACES_SECRET=               # Spaces secret key
# Free-disk alert thresholds (GB) for /api/cron/disk-maintenance. Unset → code
# defaults (warn 45, critical 32). Warn fires an email before jobs hit the ML guard.
# DISK_WARN_FREE_GB=45
# DISK_CRITICAL_FREE_GB=32
# Recipients for the disk-space alert email (csv). Falls back to PORTAL_UPDATES_EMAILS.
DISK_ALERT_EMAILS=

# Field Uploader desktop app (GET /api/field-upload/v1/deployments)
FIELD_UPLOAD_TOKEN=            # Dedicated Bearer token for the field uploader (separate from CRON_SECRET). Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FIELD_UPLOAD_ALLOWED_PROJECTS=  # Comma-separated ct_projects.name values the endpoint will serve (e.g. "BioChoco"). Any other projectId is refused.
FIELD_UPLOAD_SA_KEY=          # Base64-encoded JSON of the DEDICATED field-upload service account (separate from GOOGLE_SERVICE_ACCOUNT_KEY). Full Drive scope, member of only the BioChoco drives, no DWD/extra IAM. Served once to the app at first run.

# OAuth2 Proxy (production only — not needed for local dev)
GOOGLE_CLIENT_ID=              # Same as fcat-dashboards
GOOGLE_CLIENT_SECRET=          # Same as fcat-dashboards
PORTAL_OAUTH_COOKIE_SECRET=   # Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'

# Grant tracking emails (monthly digest + deadline reminders)
# Sender address for the grant digest/reminder emails. Falls back to
# RESEND_FROM_EMAIL, then "portal@fcat-ecuador.org". The sender domain must be
# verified in Resend. Requires RESEND_API_KEY (and CRON_SECRET for the cron jobs).
GRANTS_FROM_EMAIL=

# IUCN Red List API v4 token (https://api.iucnredlist.org/) for the one-shot
# conservation-status backfill: scripts/backfill-iucn-status.mjs. Non-commercial
# / education-research use. Not needed at runtime — only for the backfill script.
IUCN_API_TOKEN=

# Landowner dashboard: Google Drive file id of the fixed intro/thank-you video
# streamed on every landowner page (/api/public/intro-video). Leave empty to
# hide the video block (placeholder state) until the footage is recorded.
LANDOWNER_INTRO_VIDEO_DRIVE_FILE_ID=

# Optional recipients (csv) for the landowner contact form. When unset, the
# form emails all editors/admins on the "biochoco" project.
BIOCHOCO_CONTACT_EMAILS=
