DEV_USER_EMAIL=lukebrowne@fcat-ecuador.org
DEV_USER_ROLE=super_admin
SUPER_ADMIN_EMAILS=lukebrowne@fcat-ecuador.org
ML_PYTHON_PATH=
DB_PATH=data/portal.db
ALLOWED_EMAILS_PATH=data/allowed_external_emails.txt

# ODK Central
ODK_CENTRAL_URL=https://central.fcat-ecuador.org
ODK_CENTRAL_EMAIL=
ODK_CENTRAL_PASSWORD=

# Google Sheets (BioChoco schedule)
GOOGLE_SERVICE_ACCOUNT_KEY=  # Base64-encoded service account JSON
BIOCHOCO_SHEET_ID=           # Google Sheets spreadsheet ID

# Camera Trap — Google Drive integration
CAMERA_TRAP_ROOT_FOLDER_ID=  # Drive folder ID for the root CameraTraps/ folder on Shared Drive

# Multi-Shared-Drive fan-out (both default OFF; flip discovery first, routing second)
SHARED_DRIVE_DISCOVERY_ENABLED=false  # Union discovery scan across registered drives
SHARED_DRIVE_ROUTING_ENABLED=false    # Route new deployment folders by capacity
# Optional threshold overrides (accept 75 or 0.75); defaults 0.75 / 0.85 / 0.95
# SHARED_DRIVE_SOFT_PCT=75
# SHARED_DRIVE_HARD_PCT=85
# SHARED_DRIVE_STOP_PCT=95
# Recipients for the daily Shared Drive capacity alert email (csv). Falls back
# to PORTAL_UPDATES_EMAILS if unset. Sent by /api/cron/shared-drive-alerts.
SHARED_DRIVE_ALERT_EMAILS=

# Field Uploader desktop app (GET /api/field-upload/v1/deployments)
FIELD_UPLOAD_TOKEN=            # Dedicated Bearer token for the field uploader (separate from CRON_SECRET). Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FIELD_UPLOAD_ALLOWED_PROJECTS=  # Comma-separated ct_projects.name values the endpoint will serve (e.g. "BioChoco"). Any other projectId is refused.
FIELD_UPLOAD_SA_KEY=          # Base64-encoded JSON of the DEDICATED field-upload service account (separate from GOOGLE_SERVICE_ACCOUNT_KEY). Full Drive scope, member of only the BioChoco drives, no DWD/extra IAM. Served once to the app at first run.

# OAuth2 Proxy (production only — not needed for local dev)
GOOGLE_CLIENT_ID=              # Same as fcat-dashboards
GOOGLE_CLIENT_SECRET=          # Same as fcat-dashboards
PORTAL_OAUTH_COOKIE_SECRET=   # Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
