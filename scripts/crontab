# Hourly database backup using SQLite online backup API
# Debian /etc/cron.d/ format requires the user field (root)
0 * * * * root cd /app && /usr/local/bin/node scripts/backup-db.mjs >> /app/data/backups/cron.log 2>&1

# Nightly BioChoco data refresh + email report (~midnight Ecuador / 05:00 UTC)
# Container TZ is America/New_York (EDT=UTC-4, EST=UTC-5). Ecuador is always UTC-5.
# 1 AM Eastern = midnight Ecuador during EDT; 11 PM Ecuador during EST.
0 1 * * * root . /etc/cron.d/portal-env && /usr/bin/curl -sf -X POST -H "Authorization: Bearer $CRON_SECRET" --max-time 600 --retry 3 --retry-delay 10 --retry-connrefused http://localhost:3000/api/cron/nightly-refresh >> /app/data/nightly-refresh.log 2>&1

# Nightly Shared Drive reconciliation (3:15 AM Eastern — after nightly-refresh + hourly backup)
# Sunday runs a full files.list count; weekdays run a cheap changes.list delta.
15 3 * * * root . /etc/cron.d/portal-env && /usr/bin/curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" --max-time 1800 http://localhost:3000/api/cron/reconcile-shared-drives >> /app/data/backups/cron.log 2>&1

# Daily Shared Drive capacity alert email (6 AM Eastern — after the 3:15 reconcile)
# Only sends when a drive is at/over the soft threshold; silent otherwise.
0 6 * * * root . /etc/cron.d/portal-env && /usr/bin/curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" --max-time 120 http://localhost:3000/api/cron/shared-drive-alerts >> /app/data/backups/cron.log 2>&1

# NOTE: The standalone /api/cron/portal-updates email (formerly 7 AM Eastern) is
# now folded into the 1 AM nightly-refresh email as the "Actividad de análisis"
# section — one daily BioChoco email instead of two. The portal-updates route
# remains callable manually for ad-hoc activity sends.

# Daily research application report reminders (8 AM Eastern)
0 8 * * * root . /etc/cron.d/portal-env && /usr/bin/curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" --max-time 120 http://localhost:3000/api/cron/research-reminders >> /app/data/backups/cron.log 2>&1

# Monthly committee digest — 1st of each month at 9 AM Eastern
0 9 1 * * root . /etc/cron.d/portal-env && /usr/bin/curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" --max-time 120 http://localhost:3000/api/cron/committee-monthly-digest >> /app/data/backups/cron.log 2>&1

# Daily grant deadline reminders (8:30 AM Eastern). Bearer-auth only (no XFF guard).
30 8 * * * root . /etc/cron.d/portal-env && /usr/bin/curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" --max-time 120 http://localhost:3000/api/cron/grants-reminders >> /app/data/backups/cron.log 2>&1

# Monthly grant digest — 1st of each month at 10 AM Eastern (replaces the n8n workflow)
0 10 1 * * root . /etc/cron.d/portal-env && /usr/bin/curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" --max-time 120 http://localhost:3000/api/cron/grants-monthly >> /app/data/backups/cron.log 2>&1

# Overnight audio batch — clears the BirdNET/indices backlog during the quiet
# Ecuador night. The route enqueues settled never-processed deployments and the
# unified queue drains them. The picker's UTC-5 window gate stops STARTING new
# batch jobs after 6 AM Ecuador (a running one overruns to completion).
#
# Scheduled in CONTAINER-LOCAL Eastern time, NOT Ecuador: this Vixie cron
# (3.0pl1) ignores CRON_TZ in /etc/cron.d, so the original `CRON_TZ=America/
# Guayaquil` + `0 22` fired at 22:00 Eastern = 21:00 Ecuador — an hour BEFORE
# the window opens, where the picker gate blocks every batch job from starting
# (confirmed in prod 2026-06-18). `0 23` Eastern lands INSIDE the window
# year-round: 22:00 Ecuador under EDT, 23:00 Ecuador under EST. The precise
# 6 AM cutoff is enforced by the picker's own UTC-5 gate, so the exact fire
# minute doesn't matter as long as it's inside 22:00–06:00 Ecuador.
# --max-time covers the per-candidate Drive re-counts + enqueues, NOT the
# overnight draining (the queue does that independently of this request).
0 23 * * * root . /etc/cron.d/portal-env && /usr/bin/curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" --max-time 1800 http://localhost:3000/api/cron/nightly-batch >> /app/data/backups/cron.log 2>&1
